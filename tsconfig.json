{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2022",
    "lib": ["ES2017", "DOM", "WebWorker", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik",
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./tmp",
    "paths": {
      "~/*": ["./src/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./tmp/tsconfig.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["src"]
}
